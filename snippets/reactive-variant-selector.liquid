{% liquid
  assign product_form_id = 'product-form-' | append: section.id

  assign selected_variant = product.selected_or_first_available_variant

  for variant in product.variants
    assign variant_title_down = variant.title | downcase

    if variant_title_down contains '100' and variant.available
      assign selected_variant = variant
      break
    endif
  endfor
%}

{% unless product.available %}
  {% render 'sold-out-alternative'
    , product: product %}
  {% else %}
  {% if product.options.size > 1 and product.available %}
    {% comment %} Multi-option picker: one row of buttons per option (e.g. size + concentration) {% endcomment %}
    <div id="variant-selector">
      {% for option in product.options_with_values %}
        {% liquid
          assign option_index = forloop.index0
          assign option_name_down = option.name | downcase
          assign first_value_down = option.values.first | downcase
          assign option_kind = 'other'
          assign option_heading = 'Välj ' | append: option_name_down
          if option_name_down contains 'storlek' or option_name_down contains 'size' or option_name_down contains 'volym' or option_name_down contains 'pojemno' or option_name_down contains 'größe' or first_value_down contains 'ml'
            assign option_kind = 'size'
            assign option_heading = 'Välj storlek'
          endif
        %}
        <div class="flex justify-between items-center mb-3 !mt-6">
          <h2 class="m-0 text-base font-semibold">{{ option_heading }}:</h2>
          {% if option_kind == 'size' %}
            <div class="text-sm italic text-gray-500">100 ml - vald av 8 av 10 kunder</div>
          {% endif %}
        </div>
        <div class="grid grid-cols-3 gap-3">
          {% for value in option.values %}
            {% liquid
              assign value_available = false
              for variant in product.variants
                if variant.options[option_index] == value and variant.available
                  assign value_available = true
                  break
                endif
              endfor
              assign value_selected = false
              if selected_variant.options[option_index] == value
                assign value_selected = true
              endif
            %}
            <button
              type="button"
              class="option-button rounded-lg px-2 rvs-size-btn bg-white border-2 border-solid cursor-pointer font-['Figtree'] relative {% if value_selected %}border-green-700{% else %}border-gray-200{% endif %}"
              data-option-index="{{ option_index }}"
              data-value="{{ value | escape }}"
              aria-pressed="{{ value_selected }}"
              {% unless value_available %}
                aria-disabled="true" title="{{ 'products.product.sold_out' | t | escape }}"
              {% endunless %}>
              <div class="text-sm font-semibold">{{ value }}</div>
              {% if option_kind == 'size' %}
                {% if value contains '50' %}
                  <span class="text-xs italic text-white rounded absolute -top-2.5 left-1/2 [transform:translateX(-50%)] bg-[#c8202f] px-2 py-0.5 whitespace-nowrap">Mest Populär</span>
                {% endif %}
                {% if value contains '100' %}
                  <span class="text-xs italic text-white rounded absolute -top-2.5 left-1/2 [transform:translateX(-50%)] bg-[#22613a] px-2 py-0.5 whitespace-nowrap">Bäst värde</span>
                {% endif %}
              {% endif %}
            </button>
          {% endfor %}
        </div>
      {% endfor %}
    </div>
  {% elsif product.variants.size > 1 and product.available %}
    {% comment %} Variant Selector {% endcomment %}
    <div class="flex justify-between items-center mb-3 !mt-6">
      <h2 class="m-0 text-base font-semibold">Välj storlek:</h2>
      <div class="text-sm italic text-gray-500">100 ml - vald av 8 av 10 kunder</div>
    </div>

    <div class="grid grid-cols-3 gap-3" id="variant-selector">
      {% for variant in product.variants %}
        {% liquid
          assign variant_ml = 0
          if variant.title contains '100'
            assign variant_ml = 100
          elsif variant.title contains '50'
            assign variant_ml = 50
          elsif variant.title contains '30'
            assign variant_ml = 30
          endif

          if variant_ml > 0
            assign price_per_ml = variant.price | times: 1.0 | divided_by: variant_ml
          endif
        %}
        <button
          type="button"
          class="variant-button rounded-lg px-2 rvs-size-btn bg-white border-2 border-solid cursor-pointer font-['Figtree'] relative {% if variant.id == selected_variant.id %}border-green-700{% else %}border-gray-200{% endif %}"
          data-variant-id="{{ variant.id }}"
          data-variant-ml="{{ variant_ml }}"
          data-variant-title="{{ variant.title }}"
          data-original-price="{{ variant.price | money }}"
          data-afterpay-price="{{ variant.price |  divided_by: 4 |  money }}"
          data-compare-price="{{ variant.compare_at_price | money }}">
          <div class="text-sm font-semibold">{{ variant.title }}</div>
          {% if variant.title contains '50' %}
            <span class="text-xs italic text-white rounded absolute -top-2.5 left-1/2 [transform:translateX(-50%)] bg-[#c8202f] px-2 py-0.5 whitespace-nowrap">Mest Populär</span>
          {% endif %}
          {% if variant.title contains '100' %}
            <span class="text-xs italic text-white rounded absolute -top-2.5 left-1/2 [transform:translateX(-50%)] bg-[#22613a] px-2 py-0.5 whitespace-nowrap">Bäst värde</span>
          {% endif %}
          {% if variant_ml > 0 %}
            <div class="text-xs text-gray-500 price-per-ml">{{ price_per_ml | money }} / ml</div>
          {% endif %}
        </button>
      {% endfor %}
    </div>
    {% if product.tags contains 'variant_note' %}
      <div id="variantSuggestion" class="mb-4 text-black text-lg"></div>
    {% endif %}
  {% endif %}

  {% comment %} Add to cart form {% endcomment %}
  <product-form
    class="product-form !m-0"
    data-hide-errors="{{ gift_card_recipient_feature_active }}"
    data-section-id="{{ section.id }}">
    {%- form 'product'
      , product
      , id: product_form_id
      , class: 'form'
      , novalidate: 'novalidate'
      , data-type: 'add-to-cart-form' -%}
      <input
        type="hidden"
        name="id"
        id="product-variant-id"
        value="{{ selected_variant.id }}"
        class="product-variant-id">
      {% if product.metafields.custom.choose_your_fragrances_options != blank %}
        {% render 'bundle-mix-dropdown' %}
      {% else %}
        <input
          type="hidden"
          name="properties[Inspired By]"
          value="{{ product.metafields.custom.nuta }}" />
      {% endif %}
      <button
        type="submit"
        name="add"
        value="1"
        class="atc-button shimmer-btn cta_product_from_submit_btn flex flex-wrap items-center !mb-0 text-2xl !pb-3 !pt-3 rounded-lg button bg-[#22613a] hover:bg-[#368856] transition-colors shadow-xl tracking-normal button--full-width button--primary"
        aria-label="Add to cart"
        {% if product.metafields.custom.choose_your_fragrances_options != blank %}
        disabled="disabled"
        {% endif %}>
        <span>{{ 'products.product.add_to_cart' | t }}</span>
        <div class="ml-2 pl-2 border-0 border-l flex items-center border-solid border-gray-200/20">
          <div
            class="inline-block text-lg bg-[#1E5834] px-3 rounded"
            id="product-price"
            role="status"
            {{ block.shopify_attributes }}>
            {% if selected_variant.compare_at_price > selected_variant.price %}
              <span class="compare-price line-through text-white/50 text-base">{{ selected_variant.compare_at_price | money }}</span>
            {% endif %}
            <span class="current-price">{{ selected_variant.price | money }}</span>
          </div>
        </div>
        {%- render 'loading-spinner' -%}
      </button>
    {%- endform -%}
  </product-form>{% endunless %}
{%- comment -%} FUEL_06 product page entry (2026-09-30), see snippets/fuel06-pdp-link.liquid. {%- endcomment -%}
{%- render 'fuel06-pdp-link' -%}

<div>
  <img
    class="max-w-full mx-auto mt-8 block [filter:grayscale(1)]"
    src="{{ 'payment-badge.png' | asset_url }}"
    alt="Payment methods"
    width="100%"
    height="auto"
    loading="lazy">
</div>

{% unless product.template_suffix == 'cro-deck' %}
  <div class="!my-6">
    <p class="my-0 text-center font-semibold tracking-normal">
      Levereras till
      <span class="shipping_location">{{ localization.country.name }}</span>
      inom 5 arbetsdagar.
    </p>
  </div>
{% endunless %}

<script>
  (function() {
    // Variant data object
    const variantsData = {
      {% for variant in product.variants %}
        "{{ variant.id }}": {
          title: "{{ variant.title }}",
          options: {{ variant.options | json }},
          available: {{ variant.available }},
          originalPrice: "{{ variant.price | money }}",
          compareAtPrice: "{{ variant.compare_at_price | money }}",
          hasComparePrice: {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
          nextVariant: "{{ variant.metafields.custom.next_variant | default: '' }}",
          priceDifference: "{{ variant.metafields.custom.price_difference.value | money | default: '' }}"
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    };

    // State
    let selectedVariantId = "{{ selected_variant.id }}";

    // DOM elements
    const variantButtons = document.querySelectorAll('.variant-button');
    const optionButtons = document.querySelectorAll('#variant-selector .option-button');
    const variantIdInput = document.getElementById('product-variant-id');
    const priceContainer = document.getElementById('product-price');
    if (!priceContainer) return;
    const comparePriceSpan = priceContainer.querySelector('.compare-price');
    const currentPriceSpan = priceContainer.querySelector('.current-price');
    const variantSuggestion = document.getElementById('variantSuggestion');

    // Update variant selection
    function updateVariant(variantId) {
      selectedVariantId = variantId;
      const variantData = variantsData[variantId];

      // Update hidden input
      variantIdInput.value = variantId;

      // Update button styles
      variantButtons.forEach(button => {
        if (button.dataset.variantId === variantId) {
          button.classList.add('border-green-700');
          button.classList.remove('border-gray-200');
        } else {
          button.classList.remove('border-green-700');
          button.classList.add('border-gray-200');
        }
      });

      optionButtons.forEach(button => {
        const chosen = (variantData.options || [])[Number(button.dataset.optionIndex)] === button.dataset.value;
        button.classList.toggle('border-green-700', chosen);
        button.classList.toggle('border-gray-200', !chosen);
        button.setAttribute('aria-pressed', chosen ? 'true' : 'false');
      });

      // Update price display
      if (variantData.hasComparePrice) {
        if (!comparePriceSpan) {
          const newCompareSpan = document.createElement('span');
          newCompareSpan.className = 'compare-price line-through text-white/50 text-base';
          priceContainer.insertBefore(newCompareSpan, currentPriceSpan);
        }
        const compareSpan = priceContainer.querySelector('.compare-price');
        compareSpan.innerHTML = variantData.compareAtPrice;
        compareSpan.style.display = '';
      } else {
        if (comparePriceSpan) {
          comparePriceSpan.style.display = 'none';
        }
      }

      currentPriceSpan.innerHTML = variantData.originalPrice;

       // Update all other current-price elements in the page
      const allCurrentPriceElements = document.querySelectorAll('.current-price');
      allCurrentPriceElements.forEach(element => {
        // Skip the main price container element that we already updated
        if (element !== currentPriceSpan && element.textContent.trim() !== '') {
          element.innerHTML = variantData.originalPrice;
        }
      });

      if(variantSuggestion && typeof variantSuggestion !== 'undefined') {
        if(variantData.title !== "100ML") {
          if(variantData.title === '50ML') {
            variantSuggestion.innerHTML = `You're <strong>${variantData.priceDifference}</strong> away from the best value size.`;
          } else {
            variantSuggestion.innerHTML = `Upgrade to ${variantData.nextVariant} for <strong>${variantData.priceDifference}</strong> more!`;
          }
        } else {
          variantSuggestion.innerHTML = 'Congratulations! You have the best deal!';
        }
      }
    }

    // Add click event listeners to variant buttons
    variantButtons.forEach(button => {
      button.addEventListener('click', function() {
        const variantId = this.dataset.variantId;
        updateVariant(variantId);
      });
    });

    // Multi-option rows: keep the other options, fall back to any in-stock variant with the clicked value
    optionButtons.forEach(button => button.addEventListener('click', function() {
      const index = Number(this.dataset.optionIndex), value = this.dataset.value;
      const wanted = ((variantsData[selectedVariantId] || {}).options || []).slice();
      wanted[index] = value;
      const ids = Object.keys(variantsData);
      const match = ids.find(id => variantsData[id].available && variantsData[id].options.every((o, i) => o === wanted[i]))
        || ids.find(id => variantsData[id].available && variantsData[id].options[index] === value);
      if (match) updateVariant(match);
    }));
  })();
</script>