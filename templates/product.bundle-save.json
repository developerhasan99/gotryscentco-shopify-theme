    "massive_review_kNQzrH": {
      "type": "massive-review",
      "blocks": {
        "review_BiNEhG": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_02_tilted_closeup.jpg",
            "content": "<p>\"Detta är mitt första köp och jag är såld. Jag kommer aldrig köpa parfym någon annanstans igen. Jag har aldrig hittat en inspirerad doft som verkligen luktar autentisk och konsekvent.\"</p>",
            "author": "Erik Lindström",
            "date": "1 dag sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "bergamot-sage-cedar-50-ml"
          }
        },
        "review_EB9Mqy": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_02_closeup_alt.jpg",
            "content": "<p>\"Den bästa doften jag sniffat på väldigt länge — noterna gör mig lycklig. Den stannar i min rotation för alltid.\"</p>",
            "author": "Astrid Lindahl",
            "date": "2 dagar sedan",
            "rating": 4,
            "show_verified_badge": true,
            "product": "4x-50ml-perfume-bottles"
          }
        },
        "review_Hk9a4q": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_03_angled.jpg",
            "content": "<p>\"Luktar underbart, jag blev helt förtjust.\"<br/><br/></p>",
            "author": "Gustav Berglund",
            "date": "2 månader sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "tryscent-collection"
          }
        },
        "review_YGFTYR": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_02_closeup_alt_25fa526a-0b24-4195-8d3f-02a50e042f35.jpg",
            "content": "<p>\"Alla tre dofter jag fick är mycket bra. De håller länge och luktar precis som de ska. Jag var bara lite missnöjd med leveranstiden — men jag har redan lagt en ny beställning, så räkna med lite väntetid. Haha!\"</p>",
            "author": "Alice Nygren",
            "date": "2 dagar sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "apple-cinnamon-sandalwood"
          }
        },
        "review_FaDAcC": {
          "type": "review",
          "disabled": true,
          "settings": {
            "review_image": "shopify://shop_images/dupestore_3221df98-e409-4141-82ec-bdbe62af3756.jpg",
            "content": "<p>\"Been trying to find scents that smell expensive as well as lasted long, to no avail. The fit is exactly what I was looking for..\"</p>",
            "author": "Tiana N.",
            "date": "2 days ago",
            "rating": 4,
            "show_verified_badge": true,
            "product": "fresh-escape-premium"
          }
        },
        "review_dCRbjp": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_04_handheld_closeup.jpg",
            "content": "<p>\"Luktar väldigt gott men håller inte lika länge som man skulle vilja.\"</p>",
            "author": "Ella Lundberg",
            "date": "3 veckor sedan",
            "rating": 5,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_QRQAwk": {
          "type": "review",
          "settings": {
            "content": "<p>\"Jag visste inte riktigt vad jag förväntade mig, men det här imponerade verkligen på mig. Luktar superfriskt och är ärligt talat väldigt nära Aventus. Den håller bra och priset är mycket bättre.\"<br/><br/></p>",
            "author": "Oscar Nyström",
            "date": "4 dagar sedan",
            "rating": 4,
            "show_verified_badge": true,
            "product": "pineapple-smoke-vanilla-50-ml-1-7-fl-oz"
          }
        },
        "review_Kr3jTT": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/face_bottle_03_bottle_forward_square.jpg",
            "content": "<p>\"En av mina favoritdofter. Kom snabbt. Luktar så gott.\"</p>",
            "author": "William Söderberg",
            "date": "2 dagar sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": ""
          }
        },
        "review_6fGXhj": {
          "type": "review",
          "settings": {
            "content": "<p>\"Jag ÄLSKAR dessa parfymer!!! Varenda en jag fått luktar gudomligt. Några skulle jag till och med säga är bättre än originalet.\"</p>",
            "author": "Freja Sandström",
            "date": "5 dagar sedan",
            "rating": 4,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_4UVr9H": {
          "type": "review",
          "settings": {
            "content": "<p>\"Till en början var jag orolig att leveransen var lite försenad, men när jag väl fick dem blev jag helt överväldigad av doften när den sätter sig är den helt enkelt fantastisk.\"</p>",
            "author": "Alexander Holmgren",
            "date": "3 dagar sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "4x-100ml-perfume-bottles"
          }
        },
        "review_Ae86bT": {
          "type": "review",
          "settings": {
            "content": "<p>\"Perfekt och vacker. 🤩🤩🤩\"</p>",
            "author": "Maja Holmberg",
            "date": "1 månad sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "saffron-rose-amber-50-ml-1-7-fl-oz"
          }
        },
        "review_cYkBHa": {
          "type": "review",
          "settings": {
            "content": "<p>\"Perfekt doftande parfymer — dofterna håller väldigt länge, utmärkt kvalitet.\"</p>",
            "author": "Saga Norlund",
            "date": "2 månader sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "6x-30ml-perfume-bottles"
          }
        },
        "review_yiKmVU": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_02_flatlay_closeup.jpg",
            "content": "<p>\"Luktar precis som Luna Rossa Carbon, men mycket billigare. Kan knappt tro hur nära den är.\"</p>",
            "author": "Anton Sandberg",
            "date": "2 veckor sedan",
            "rating": 4,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_7w3MEB": {
          "type": "review",
          "settings": {
            "content": "<p>\"Det är den typen av doft som får dig att känna dig samlad. Inte överväldigande — precis lagom.\"</p>",
            "author": "Lucas Ekström",
            "date": "2 månader sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "alpha-oil"
          }
        },
        "review_aHxDQq": {
          "type": "review",
          "settings": {
            "content": "<p>\"Fantastiskt märke och fantastiska produkter!\"</p>",
            "author": "Elsa Bergman",
            "date": "4 månader sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "4x-50ml-perfume-bottles"
          }
        },
        "review_4eV9Bk": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_05_pair_alt.jpg",
            "content": "<p>\"Produkten kom fint förpackad. Parfymen var inte trasig, läckte inte och var i gott skick. Doften är perfekt och luktar härligt. Jag älskar den hög kvalitet.\"</p>",
            "author": "Olivia Ström",
            "date": "2 månader sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "jasmine-cocoa-tonka"
          }
        },
        "review_7WryfC": {
          "type": "review",
          "settings": {
            "content": "<p>\"Jag har burit Creed Aventus i flera år, men det här är den närmaste inspirerade versionen jag hittat och till en bråkdel av priset. Kombinationen av ananas och vanilj stämmer perfekt.\"</p>",
            "author": "Viktor Lundqvist",
            "date": "1 månad sedan",
            "rating": 4,
            "show_verified_badge": true,
            "product": "pineapple-smoke-vanilla-50-ml-1-7-fl-oz"
          }
        },
        "review_hy4jry": {
          "type": "review",
          "settings": {
            "content": "<p>\"Produkten kom välförpackad. Parfymen var inte trasig, läckte inte och var i fint skick. Doften är perfekt och luktar inte illa. Jag älskar den, hög kvalitet.\"</p>",
            "author": "Alma Ekberg",
            "date": "1 vecka sedan",
            "rating": 4,
            "show_verified_badge": true,
            "product": "azure-dreams-pure"
          }
        },
        "review_KjieX9": {
          "type": "review",
          "settings": {
            "content": "<p>\"Underbar doft. Långvarig. Söt och varm. Snabb leverans. Köper igen.\"</p>",
            "author": "Linnea Dahlberg",
            "date": "3 veckor sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "6x-30ml-perfume-bottles"
          }
        },
        "review_WzFnRc": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/bottle_08_boxed_pick.jpg",
            "content": "<p>\"Jag är nöjd med TryScent. Doften liknar originalet väldigt mycket och håller bra. Förpackningen är snygg och flaskan ser fin ut. Sammantaget ett utmärkt alternativ om du vill ha en kvalitetsparfym till ett rimligt pris.\"</p>",
            "author": "Filip Åkesson",
            "date": "1 månad sedan",
            "rating": 5,
            "show_verified_badge": false,
            "product": ""
          }
        },
        "review_DaxWQA": {
          "type": "review",
          "settings": {
            "content": "<p>\"Deras produkter håller hög kvalitet till ett mycket prisvärt pris.\"</p>",
            "author": "Ebba Forslund",
            "date": "2 månader sedan",
            "rating": 4,
            "show_verified_badge": true,
            "product": "amber-glow"
          }
        },
        "review_ErjyKR": {
          "type": "review",
          "settings": {
            "content": "<p>\"Fantastiska dofter, fantastiska produkter, inga problem.\"<br/></p>",
            "author": "Ida Hultgren",
            "date": "1 månad sedan",
            "rating": 5,
            "show_verified_badge": true,
            "product": "azure-dreams-pure"
